.nav-link svg { stroke-width: 1.8px; width: 18px; height: 18px; }

.side-footer { border-top: 1px solid hsl(var(--sidebar-border)); margin-top: auto; padding: 17px 10px 0px; }

.offline-chip { color: rgb(102, 128, 119); align-items: center; gap: 8px; font-size: 11px; display: flex; }

.offline-dot { background: rgb(101, 170, 131); border-radius: 50%; width: 7px; height: 7px; box-shadow: rgb(224, 240, 229) 0px 0px 0px 3px; }

