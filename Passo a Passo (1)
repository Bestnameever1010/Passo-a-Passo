.main-area { flex: 1 1 0%; min-width: 0px; margin-left: 248px; }

.topbar { justify-content: space-between; align-items: center; max-width: 1320px; height: 72px; margin: auto; padding: 0px 50px; display: flex; }

.crumb { color: rgb(131, 147, 141); font-size: 12px; }

.top-actions { align-items: center; gap: 12px; display: flex; }

.date-pill { color: rgb(86, 113, 104); background: rgb(232, 241, 235); border-radius: 999px; padding: 8px 12px; font-size: 11px; font-weight: 600; }

